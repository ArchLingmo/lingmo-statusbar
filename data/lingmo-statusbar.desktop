[Desktop Entry]
Type=Application
Name=Lingmo Status Bar
Comment=The bar at the top of the screen
Exec=/usr/bin/lingmo-statusbar
Icon=preferences-system-windows
NoDisplay=true
Terminal=false
# Wayland: KWin hands the window list (active window, its title and actions) only
# to programs that ask for it here
X-KDE-Wayland-Interfaces=org_kde_plasma_window_management
